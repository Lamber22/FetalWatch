{
  "expo": {
    "name": "FetalWatch",
    "slug": "fetalwatch-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo/fetalwatch.png",
    "scheme": "fetalwatch",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fetalwatch.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo/fetalwatch.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.fetalwatch.mobile",
      "edgeToEdgeEnabled": true,
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo/fetalwatch.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#007AFF"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "45cbfe42-2efb-4181-9970-b52542ab6935"
      }
    }
  }
}
